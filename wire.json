name: Live wire (every 10 minutes)

on:
  schedule:
    - cron: "*/10 * * * *"
  workflow_dispatch:
    inputs:
      backfill:
        description: "Also fetch older headlines back to 1 October (run once)"
        type: boolean
        default: false

permissions:
  contents: write

concurrency:
  group: wire
  cancel-in-progress: false

jobs:
  wire:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Fetch headlines
        run: python3 scripts/fetch_wire.py ${{ inputs.backfill && '--backfill' || '' }}
      - name: Commit if changed
        run: |
          git config user.name "dira-signal-wire"
          git config user.email "actions@users.noreply.github.com"
          cp wire.json "$RUNNER_TEMP/wire.json"
          cp -r archive "$RUNNER_TEMP/archive"
          git fetch origin "${GITHUB_REF_NAME}"
          git reset --hard "origin/${GITHUB_REF_NAME}"
          cp "$RUNNER_TEMP/wire.json" wire.json
          rm -rf archive && cp -r "$RUNNER_TEMP/archive" archive
          git add wire.json archive
          if git diff --cached --quiet; then echo "No change"; exit 0; fi
          git commit -m "Live wire update"
          git push origin "HEAD:${GITHUB_REF_NAME}"
